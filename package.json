{
  "name": "@streamflix/monorepo",
  "version": "1.0.0",
  "description": "StreamFlix microservices architecture with pnpm workspace",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:order": "pnpm --filter order-service run dev",
    "build": "pnpm --recursive run build",
    "build:order": "pnpm --filter order-service run build",
    "start": "pnpm --parallel --recursive run start",
    "start:order": "pnpm --filter order-service run start",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "install:all": "pnpm install",
    "db:generate": "pnpm --recursive run db:generate",
    "db:migrate": "pnpm --recursive run db:migrate",
    "db:studio": "pnpm --parallel --recursive run db:studio",
    "db:generate:order": "pnpm --filter order-service run db:generate",
    "db:migrate:order": "pnpm --filter order-service run db:migrate",
    "db:studio:order": "pnpm --filter order-service run db:studio",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "test": "pnpm --recursive run test",
    "test:watch": "pnpm --recursive run test:watch",
    "type-check": "pnpm --recursive run type-check",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "new-service": "node scripts/create-service.js"
  },
  "keywords": [
    "microservices",
    "fastify",
    "drizzle",
    "typescript",
    "pnpm-workspace",
    "streamflix"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.2.2",
    "tsx": "^4.6.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "prettier": "^3.1.0",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0"
}
