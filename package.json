{
  "name": "@streamflix/monorepo",
  "version": "1.0.0",
  "description": "StreamFlix microservices architecture with pnpm workspace",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:order & pnpm run dev:invoice",
    "dev:order": "cd apps/order-service && pnpm run dev",
    "dev:invoice": "cd apps/invoice-service && pnpm run dev",
    "build": "pnpm run build:order && pnpm run build:invoice",
    "build:order": "cd apps/order-service && pnpm run build",
    "build:invoice": "cd apps/invoice-service && pnpm run build",
    "start": "pnpm --parallel --recursive run start",
    "start:order": "pnpm --filter order-service run start",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "install:all": "pnpm install",
    "db:generate": "pnpm --recursive run db:generate",
    "db:migrate": "pnpm --recursive run db:migrate",
    "db:studio": "pnpm --recursive run db:studio",
    "db:generate:order": "pnpm --filter order-service run db:generate",
    "db:migrate:order": "pnpm --filter order-service run db:migrate",
    "db:studio:order": "pnpm --filter order-service run db:studio",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "type-check": "pnpm run type-check:order && pnpm run type-check:invoice",
    "type-check:order": "cd apps/order-service && pnpm run type-check",
    "type-check:invoice": "cd apps/invoice-service && pnpm run type-check",
    "test": "pnpm run test:order && pnpm run test:invoice",
    "test:order": "cd apps/order-service && pnpm run test",
    "test:invoice": "cd apps/invoice-service && pnpm run test",
    "test:watch": "pnpm run test:watch:order",
    "test:watch:order": "cd apps/order-service && pnpm run test:watch",
    "test:watch:invoice": "cd apps/invoice-service && pnpm run test:watch",
    "db:reset": "./scripts/reset-databases.sh",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "new-service": "node scripts/create-service.js",
    "prepare": "husky",
    "pre-commit": "pnpm run type-check"
  },
  "keywords": [
    "microservices",
    "fastify",
    "drizzle",
    "typescript",
    "pnpm-workspace",
    "streamflix"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vitest/ui": "^2.1.8",
    "amqplib": "^0.10.4",
    "concurrently": "^8.2.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.33.0",
    "eslint": "^8.54.0",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "pg": "^8.13.1",
    "prettier": "^3.1.0",
    "testcontainers": "^10.17.1",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0",
  "lint-staged": {
    "apps/order-service/src/**/*.{ts,tsx}": [
      "bash -c 'pnpm run type-check:order'"
    ],
    "apps/invoice-service/src/**/*.{ts,tsx}": [
      "bash -c 'pnpm run type-check:invoice'"
    ],
    "apps/shared-broker/src/**/*.{ts,tsx}": [
      "bash -c 'pnpm --filter shared-broker run type-check'"
    ]
  }
}
